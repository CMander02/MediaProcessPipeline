# MediaProcessPipeline 启动环境变量示例
# 运行时业务设置统一保存在仓库根目录 config.json（通过网页设置或 `mpp config` 修改）。
# 本文件仅列出 `backend/app/core/config.py` 读取的初始环境变量默认值。

DEBUG=false
DATA_ROOT=

# 默认初始 Provider 密钥（日常使用建议在网页「设置」中配置到 config.json）
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
HF_TOKEN=

# 本地 Pyannote 模型默认目录（可选）
PYANNOTE_MODEL_PATH=
PYANNOTE_SEGMENTATION_PATH=

# 本地 UVR 模型默认目录（可选）
UVR_MODEL=UVR-MDX-NET-Inst_HQ_3
UVR_MODEL_DIR=
UVR_MDX_INST_HQ3_PATH=
UVR_HP_UVR_PATH=
UVR_DENOISE_LITE_PATH=
UVR_KIM_VOCAL_2_PATH=
UVR_DEECHO_DEREVERB_PATH=
UVR_HTDEMUCS_PATH=

# Bilibili SESSDATA（可选，推荐使用网页扫码登录写入 state/auth/）
BILIBILI_SESSDATA=
