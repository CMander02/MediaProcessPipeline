{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "web:dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "android:add": "npm run build && cap add android",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:run": "npm run android:sync && cap run android",
    "android:apk": "npm run android:sync && node scripts/android-gradle.mjs assembleDebug",
    "android:check": "npm run lint && npm run test && npm run android:sync && node scripts/android-gradle.mjs testDebugUnitTest lintDebug assembleDebug",
    "tauri": "tauri",
    "legacy:tauri:dev": "tauri dev",
    "tauri:dev": "tauri dev",
    "tauri:build": "powershell -NoProfile -ExecutionPolicy Bypass -File ../scripts/build-desktop.ps1",
    "tauri:build:debug": "powershell -NoProfile -ExecutionPolicy Bypass -File ../scripts/build-desktop.ps1 -Debug",
    "tauri:build:portable": "powershell -NoProfile -ExecutionPolicy Bypass -File ../scripts/build-desktop.ps1 -NoBundle",
    "tauri:build:portable:debug": "powershell -NoProfile -ExecutionPolicy Bypass -File ../scripts/build-desktop.ps1 -Debug -NoBundle"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.5.0",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/network": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@fontsource-variable/noto-sans": "^5.2.10",
    "@hugeicons/core-free-icons": "^4.0.0",
    "@hugeicons/react": "^1.1.6",
    "@lobehub/icons": "^5.10.0",
    "@tailwindcss/vite": "^4.2.2",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "artplayer": "^5.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "defuddle": "^0.19.1",
    "katex": "^0.17.0",
    "markmap-lib": "^0.18.12",
    "markmap-view": "^0.18.12",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.7.3",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shadcn": "^4.0.8",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@eslint/js": "^9.39.4",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jsdom": "^29.1.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
